---
import fetchApi from "../../lib/strapi";
import Wrapper from "../../components/wrapper.astro";
import Header from "../../components/header.astro";
import Footer from "../../components/footer.astro";
import Breadcrumbs from "../../components/breadcrumbs.astro";
import { Image } from "astro:assets";
import type { collaboratorLinkTypes } from "../../types/collaborator-link-types";

type CoupleTypes = {
  bride: string;
  groom: string;
  slug: string;
  title?: string;
  mux?: string;
  hero?: {
    url: string;
    alternativeText: string;
    width?: number;
    height?: number;
  };
  gallery?: {
    url: string;
    alternativeText: string;
    width?: number;
    height?: number;
  }[];
  collaborators?: collaboratorLinkTypes[];
};
export async function getStaticPaths() {
  const couples = await fetchApi<CoupleTypes[]>({
    endpoint: "couples",
    populate: {
      hero: true,
      gallery: true,
      collaborators: true,
    },
  });

  return couples.map((couple) => ({
    params: { slug: couple.slug },
    props: couple,
  }));
}
const couple = Astro.props;
---

<Wrapper
  seo={{
    title: `${couple.bride} & ${couple.groom}`,
  }}
>
  <Header />

  <h1 class="serif center pelican">
    {couple.title ? couple.title : `${couple.bride} & ${couple.groom}`}
  </h1>

  {
    couple.mux ? (
      <main class="pelican">
        <mux-player playback-id={couple.mux} />
        <script>import "@mux/mux-player";</script>
      </main>
    ) : (
      couple.hero && (
        <main class="gallery">
          <button class="gallery-item" type="button">
            <Image
              src={couple.hero.url}
              width={couple.hero.width || 1200}
              height={couple.hero.height || 600}
              alt={`${couple.hero.alternativeText} | ${couple.bride}`}
            />
          </button>

          {couple.gallery &&
            couple.gallery.map((image) => (
              <button class="gallery-item" type="button">
                <Image
                  src={image.url}
                  width={image.width || 1200}
                  height={image.height || 600}
                  alt={`${image.alternativeText} | ${couple.bride} & ${couple.groom}`}
                />
              </button>
            ))}
        </main>
      )
    )
  }

  <hr />

  {
    couple.collaborators && couple.collaborators.length > 0 && (
      <div class="collaborators">
        <h2 class="serif">Collaborators</h2>
        <ul>
          {couple.collaborators.map((collab) => (
            <li>
              <a href={`/collaborators/${collab.slug}`} class="serif">
                {collab.name}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</Wrapper>
<Breadcrumbs
  items={[
    { label: "Couples", href: "/couples" },
    {
      label: couple.title ? couple.title : `${couple.bride} & ${couple.groom}`,
    },
  ]}
/>
<Footer />

<script>
  import Masonry from "masonry-layout";

  const gallery = document.querySelector<HTMLElement>(".gallery");
  const supportsGridLanes = CSS.supports("display", "grid-lanes");
  let masonry: Masonry | undefined;

  const updateSelectedSpan = () => {
    if (!gallery || !supportsGridLanes) {
      return;
    }

    const gridTemplateColumns = getComputedStyle(gallery).gridTemplateColumns;

    if (!gridTemplateColumns || gridTemplateColumns === "none") {
      return;
    }

    const columnCount = gridTemplateColumns.split(" ").filter(Boolean).length;

    gallery.style.setProperty("--gallery-column-count", String(columnCount));
  };

  if (gallery && !supportsGridLanes) {
    const galleryStyles = getComputedStyle(gallery);
    const gap = parseFloat(galleryStyles.rowGap || galleryStyles.gap) || 16;

    gallery.classList.add("gallery--masonry");

    masonry = new Masonry(gallery, {
      itemSelector: ".gallery-item",
      gutter: gap,
      percentPosition: true,
    });
  }

  updateSelectedSpan();
  window.addEventListener("resize", updateSelectedSpan);

  gallery?.addEventListener("click", (event) => {
    const target = event.target;

    if (!(target instanceof HTMLElement)) {
      return;
    }

    const image = target.closest(".gallery-item");

    if (!(image instanceof HTMLElement)) {
      return;
    }

    image.classList.toggle("selected");
    updateSelectedSpan();
    masonry?.layout();
  });
</script>

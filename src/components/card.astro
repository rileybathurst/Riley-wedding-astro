---
const { title, excerpt, link, image, imageAlt, imageWidth, imageHeight, mux, header, footer } =
  Astro.props;

import { Image } from "astro:assets";
---

<article class="">
  <a href={link} class="card serif">
    {
      mux && (
        <Image
          // src={`https://image.mux.com/${mux}/thumbnail.jpg?width=400&height=300&fit_mode=pad`}
          src={`https://image.mux.com/${mux}/thumbnail.jpg`}
          // width={400}
          // height={300}
          alt={`${title} video thumbnail`}
        />
      )
    }

    <!-- has a cloudinary crop -->
    {
      image && image.includes("/upload/")
        ? (() => {
            const [before, after] = image.split("/upload/");
            const newImage = `${before}/upload/c_crop/${after}`;
            return (
              <Image
                src={newImage}
                // width={imageWidth || 1200}
                // height={imageHeight || 600}
                alt={imageAlt || title}
              />
            );
          })()
        : null
    }

    <!-- <h3>
      {title}
    </h3> -->
    <h3 class="header">{header}</h3>
    <h3 class="footer">{footer}</h3>
    <!-- <p>{excerpt}</p> -->
    <div class="overlay">{/* stay gold */}</div>
  </a>
</article>
